# ==============================================================================
# OSPF TopoViz - Environment Variables Template
# Copy this file to .env and replace placeholders with actual values:
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

# Device SSH Credentials (overrides values in config/settings.yaml)
OSPF_POLLER_USERNAME="noc_operator"
OSPF_POLLER_PASSWORD="CHANGE_ME_PASSWORD"
OSPF_POLLER_SECRET=""

# Telegram Alerting Pipeline Configuration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN="000000000:AAFg-XXXXXXXXXXXXXXXXXXXXXXXXXX"
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_MESSAGE_THREAD_ID=""
TELEGRAM_MIN_SEVERITY="warning"
TELEGRAM_COOLDOWN_SECONDS=300
TELEGRAM_SILENT=false
TELEGRAM_SEND_IMAGE=true
TELEGRAM_PROXY_URL=""

# CLI Output Formatting (optional: set to 1 to disable terminal colors)
# NO_COLOR=1
