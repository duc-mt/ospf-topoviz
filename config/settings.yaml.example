# ==============================================================================
# File Name:     settings.yaml.example
# Description:   Example configuration template for OSPF TopoViz.
# Author:        Mai Tan Duc <ducmai.network@gmail.com>
# Created:       2026-10-10
# Version:       1.0.0
# License:       MIT
# ==============================================================================
# OSPF TopoViz - settings template
#
# Credentials can also come from the environment, which then wins over this file:
#   OSPF_MONITOR_USERNAME, OSPF_MONITOR_PASSWORD, OSPF_MONITOR_SECRET
# Do not commit real credentials into git.

# ---- Seed routers -------------------------------------------------------------------------------
# One or more routers whose OSPF database is read. "merge" polls them all and combines what they see
# (seeds in different areas -> one diagram of the whole network); "fallback" uses the first seed, by
# priority, that answers (high availability for a single view). --mode and --seeds override these.
seeds:
  mode: merge                # merge | fallback
  concurrency: 5             # merge mode: SSH sessions at the same time
  timeout_per_device: 10     # seconds to wait for each connection stage (TCP, SSH banner, login);
                             #   LSDB commands keep read_timeout. A device may set its own conn_timeout etc.
  # require_all: false       # merge mode: abort instead of carrying on when a seed fails
  username: admin            # shared by every device below that does not set its own

  # Settings written here apply to every device below that does not set its own:
  #   device_type, username, password, secret, port, ospf_process_id, *_timeout, commands
  # Credentials: a device's own value, else OSPF_MONITOR_USERNAME / _PASSWORD / _SECRET, else the value here.
  devices:
    - host: "10.255.255.6"
      device_type: vyos      # Netmiko device type = platform parser and commands (list below)
      username: admin
      password: ""           # empty -> OSPF_MONITOR_PASSWORD
      priority: 1            # fallback order, lowest first (default: the order written here)
      tags: ["Area0", "Core"]    # shown in the ROLE column of the result table
    - host: "10.255.255.4"
      device_type: vyos
      username: admin
      password: ""
      priority: 2
      tags: ["Area0", "Transit"]
    - host: "10.255.255.10"
      device_type: vyos
      priority: 3
      tags: ["Area1", "Edge"]

  # Optional per-device settings:
  #   name: core-1             # label used in logs (default: host)
  #   secret: ""               # enable secret; leave empty if the login lands in privileged mode
  #   port: 22
  #   conn_timeout / auth_timeout / banner_timeout: 15/20/20   (default: timeout_per_device)
  #   read_timeout: 120        # seconds per LSDB command (large databases are slow)
  #   commands:                # replace the built-in LSDB commands; "{pid}" = ospf_process_id
  #     router:  show ip ospf database router detail
  #     network: show ip ospf database network detail
  #
  # Netmiko device types:
  #   cisco_ios, cisco_xe    Cisco IOS / IOS-XE   (Genie)
  #   cisco_xr               Cisco IOS-XR         (Genie, default VRF)
  #   cisco_nxos             Cisco NX-OS          (Genie, default VRF)
  #   juniper_junos          Juniper Junos        (Genie)
  #   arista_eos             Arista EOS           (text parser)
  #   vyos                   VyOS / FRR           (text parser)
  #   huawei, huawei_vrpv8   Huawei VRP           (text parser)

# Legacy single-router form - still supported when there is no seeds.devices list (there the
# OSPF_MONITOR_* variables win over this file, as before):
# device:
#   host: 10.255.255.6
#   username: admin
#   password: ""
#   secret: ""
#   device_type: vyos
#   port: 22
#   conn_timeout: 15
#   auth_timeout: 20
#   banner_timeout: 20
#   read_timeout: 120

# What else to read from each router besides the LSDB (both are best effort)
polling:
  neighbors: true            # OSPF neighbour table: link colours, LSDB-vs-neighbour check, flap detection
  routes: true               # OSPF routing table: SPF-vs-RIB check (blackholes, suboptimal routing), --trace
  external: false            # AS-External (Type 5) / NSSA (Type 7) LSAs: marks ASBRs and lets --trace follow external
                             #   routes. Off by default: on a network that redistributes BGP the database is huge.
                             #   Platforms: VyOS/FRR, Cisco IOS/IOS-XE, Arista EOS, Aruba AOS-CX.

# Process ID: int (e.g. 1) or VRF/instance tag (e.g. "default", "VRF1").
# Omit for platforms that do not require a process ID.
ospf_process_id: null

# Data Quality thresholds
data_quality:
  stale_lsa_age: 2400        # seconds; an LSA older than this that is still in the database is flagged as stale
  maxage_lsa_age: 3500       # seconds; LSAs this old are being flushed (MaxAge is 3600) and are ignored altogether,
                             #   e.g. the old DR's Network LSA after a re-election. 0 = off. Keep it above stale_lsa_age

# Guard settings (protects baseline against partial LSDB runs)
guard:
  min_known_ratio: 0.70      # min ratio of previously known nodes that must still be present

# Visualization settings
visualization:
  # theme: light             # light | dark: colours of the Graphviz picture (--theme overrides). The HTML
                             #   explorer has its own auto / light / dark switch; this only sets where it starts
  direction: LR              # LR (Left to Right) or TB (Top to Bottom)
  show_costs: true
  show_addresses: true

# History of the topology ("time travel"): every accepted run is kept in data/history/history.db and can be browsed
# with the history bar of the explorer page when it is served with --serve. A run held back by the guard is not kept.
history:
  enabled: true
  max_runs: 2000             # keep the newest N runs and drop older ones; 0 = keep everything

# Embedded web server (python main.py --serve): the explorer page, the history, GET /api/trace and POST /api/poll.
# It has no login. Keep host on 127.0.0.1 unless something in front of it authenticates (a reverse proxy, a VPN).
# Each value can also come from an environment variable, which wins over this file: OSPF_MONITOR_HOST,
# OSPF_MONITOR_PORT, OSPF_MONITOR_POLL_INTERVAL. The --port flag wins over all of them.
server:
  host: 127.0.0.1
  port: 8080
  poll_interval: 0           # seconds between polls the server starts by itself; 0 = only on POST /api/poll

# Alerting & Notifications (Telegram, Webhooks)
alerting:
  enabled: false             # Master toggle for notifications
  min_severity: warning      # info | warning | critical
  cooldown_seconds: 300      # Suppress duplicate alerts for 5 minutes
  telegram:
    enabled: false
    bot_token: ""            # Or env TELEGRAM_BOT_TOKEN
    chat_id: ""              # Or env TELEGRAM_CHAT_ID (User ID or Group ID, e.g. -100...)
    thread_id: null          # Optional: Supergroup forum topic ID (or env TELEGRAM_MESSAGE_THREAD_ID)
    silent: false            # Send notification without sound (or env TELEGRAM_SILENT)
    send_image: true         # Attach topology diagram if available (or env TELEGRAM_SEND_IMAGE)
    proxy: null              # Optional: HTTP/HTTPS proxy e.g. "http://proxy:8080" (or env TELEGRAM_PROXY_URL)

