# OSPF TopoViz - settings template
#
# Credentials can also come from the environment, which then wins over this file:
#   OSPF_MONITOR_USERNAME, OSPF_MONITOR_PASSWORD, OSPF_MONITOR_SECRET
# Do not commit real credentials into git.

device:
  host: ""                       # seed router management IP or DNS name
  username: admin
  password: ""
  secret: ""                 # enable secret; leave empty if the login lands in privileged mode

  # Netmiko device type = which platform parser and commands are used:
  #   cisco_ios, cisco_xe    Cisco IOS / IOS-XE   (Genie)
  #   cisco_xr               Cisco IOS-XR         (Genie, default VRF)
  #   cisco_nxos             Cisco NX-OS          (Genie, default VRF)
  #   juniper_junos          Juniper Junos        (Genie)
  #   arista_eos             Arista EOS           (text parser)
  #   vyos                   VyOS / FRR           (text parser)
  #   huawei, huawei_vrpv8   Huawei VRP           (text parser)
  device_type: vyos

  port: 22
  conn_timeout: 15           # seconds to open the TCP connection
  auth_timeout: 20           # seconds to authenticate
  banner_timeout: 20         # seconds to wait for the SSH banner
  read_timeout: 120          # seconds to wait for each LSDB command (large databases are slow)

  # Optional: replace the built-in LSDB commands for this platform/version. "{pid}" is replaced by
  # ospf_process_id. Needed e.g. if an Arista release only prints link details with "detail".
  # commands:
  #   router:  show ip ospf database router detail
  #   network: show ip ospf database network detail

# Process ID: int (e.g. 1) or VRF/instance tag (e.g. "default", "VRF1").
# Omit for platforms that do not require a process ID.
ospf_process_id: null

# Data Quality thresholds
data_quality:
  stale_lsa_age: 3600        # seconds (1 hour); LSAs older than this are flagged as stale

# Guard settings (protects baseline against partial LSDB runs)
guard:
  min_known_ratio: 0.70      # min ratio of previously known nodes that must still be present

# Visualization settings
visualization:
  direction: LR              # LR (Left to Right) or TB (Top to Bottom)
  show_costs: true
  show_addresses: true
